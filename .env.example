# NVIDIA Queue Proxy Configuration & Secrets
# NEVER commit real secret keys to source control!

# --- Cloudflare Worker Secrets (Set via: wrangler secret put <NAME>) ---
# Required: Secret key shared with callers (e.g. backend server / MonkeyCode)
PROXY_KEY="your-proxy-key-placeholder"

# Required: Upstream NVIDIA NIM API Key (never exposed to clients)
NVIDIA_API_KEY="nvapi-your-nvidia-api-key-placeholder"

# --- Optional Rate Limiting & Cooldown Overrides (Environment Variables) ---
# Maximum requests admitted per 60-second sliding window (default: 40)
RPM=40

# Minimum milliseconds required between successive upstream request dispatches (default: 1670)
COOLDOWN_MS=1670

# Maximum number of pending requests in the FIFO queue before rejecting with 429 (default: 100)
MAX_QUEUE_DEPTH=100

# Maximum milliseconds a request is allowed to wait in queue before timing out (default: 60000)
MAX_QUEUE_WAIT_MS=60000

# Maximum request body size in bytes (default: 20971520 = 20MB)
MAX_BODY_BYTES=20971520

# Total deadline for reading the incoming request body in milliseconds (default: 30000, range 1000-120000)
REQUEST_BODY_TIMEOUT_MS=30000

# Maximum aggregate memory budget for concurrent body reads in bytes (default: 33554432 = 32MB)
MAX_AGGREGATE_BODY_BYTES=33554432

# Maximum concurrent body readers admitted before buffering (default: 100)
MAX_CONCURRENT_BODY_READS=100

# Upstream response header timeout in milliseconds (default: 30000)
RESPONSE_HEADER_TIMEOUT_MS=30000

# Upstream stream idle timeout in milliseconds (default: 30000)
STREAM_IDLE_TIMEOUT_MS=30000

# AI Studio Applet Settings
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
